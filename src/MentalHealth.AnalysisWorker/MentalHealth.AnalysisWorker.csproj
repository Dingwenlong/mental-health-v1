<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-MentalHealth.AnalysisWorker-4340d908-eabd-4d65-9f6a-4a1e59186c38</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MentalHealth.Application\MentalHealth.Application.csproj" />
    <ProjectReference Include="..\MentalHealth.Infrastructure\MentalHealth.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\config\opencv\haarcascade_frontalface_default.xml">
      <Link>config\opencv\haarcascade_frontalface_default.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\config\demo-questionnaire.v1.json">
      <Link>config\demo-questionnaire.v1.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
